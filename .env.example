# =============================================================================
# Spring AI Alibaba DataAgent - 后端环境变量模板
# =============================================================================
# 用法：
#   cp .env.example .env    # 然后按需填写
#   .env 已被 .gitignore 忽略，不会被提交
#
# application.yml 已通过 spring.config.import 自动加载根目录 .env：
#   1) 本地/IDE：复制后填写，直接启动即可
#   2) 容器：docker compose 通过 env_file 将同一文件注入后端
#   3) CI/生产：使用平台 Secrets，不应上传本地 .env
#
# 默认值来源：application.yml、application-h2.yml、application-simple.yml、
#             application-milvus.yml 中的 ${VAR:default} 语法。
#             下方每个变量的注释里标明了安全的非敏感默认值。
# 数据库连接、用户名和密码没有默认值，必须显式填写。
# =============================================================================


# -----------------------------------------------------------------------------
# 1. Spring Profile：决定加载哪个 application-<profile>.yml
#    不设置  = 使用 application.yml（向量库 type=chroma）
#    可选值  = h2 / simple / milvus（可组合，如 h2,simple）
#    注意：h2 使用独立的内存数据库，不会读取 MySQL 中的 Agent、模型等数据；
#          若原有数据看似“消失”，请先确认这里没有误设为 h2。
#    代码默认值：无（不激活任何 profile）
#    示例：SPRING_PROFILES_ACTIVE=milvus
# -----------------------------------------------------------------------------
SPRING_PROFILES_ACTIVE=

# 本地运行 Backend 时的监听端口。Docker 容器内部仍固定使用 8065。
# SERVER_HOST_PORT 是 Docker 发布到宿主机的端口。
# Windows/Hyper-V 若保留了 8065，可使用推荐值 9065。
SERVER_PORT=9065
SERVER_HOST_PORT=9065
# 本地 Nuxt 开发服务器转发 API 时使用；不配置时根据 SERVER_PORT 生成。
# Docker 前端不使用此地址，而是由 nginx 访问容器内的 backend:8065。
NUXT_BACKEND_URL=http://localhost:9065


# -----------------------------------------------------------------------------
# 2. 后端业务数据库（存 DataAgent 自身数据，非智能体分析用的数据源）
#    来源：application.yml:16-22
# -----------------------------------------------------------------------------
# 必填：例如 jdbc:mysql://127.0.0.1:3306/data_agent?...，请按实际环境填写
DATA_AGENT_DATASOURCE_URL=
# 必填
DATA_AGENT_DATASOURCE_USERNAME=
# 必填，不提供默认密码
DATA_AGENT_DATASOURCE_PASSWORD=
# 代码默认值：never（可选值 always / never）
DATA_AGENT_DATASOURCE_SQL_INIT=

# 使用 h2 Profile 时填写（仅本地内存数据库）
H2_DATASOURCE_USERNAME=
H2_DATASOURCE_PASSWORD=


# -----------------------------------------------------------------------------
# 3. 大模型 API Key
#    来源：docker-file/docker-compose.yml:30（部署时从宿主机环境透传）
#    本地开发也可以不填：启动后在「模型配置」页面添加模型即可
#    代码默认值：无
#    注意：CI 的 live-model-test 用的是另一个变量名 DATAAGENT_LIVE_DASHSCOPE_API_KEY
# -----------------------------------------------------------------------------
AI_DASHSCOPE_API_KEY=


# -----------------------------------------------------------------------------
# 4. Python 代码执行沙箱（仅启用 python 分析节点时需要）
#    来源：application.yml:49-54
# -----------------------------------------------------------------------------
# 代码默认值：unix:///var/run/docker.sock（Windows 通常为 npipe:////./pipe/docker_engine）
DATAAGENT_SANDBOX_DOCKER_HOST=
# 代码默认值：agentscope-registry.ap-southeast-1.cr.aliyuncs.com/agentscope/runtime-sandbox-base:latest
DATAAGENT_SANDBOX_IMAGE=
# 代码默认值：https://pypi.org/simple
DATAAGENT_PYPI_INDEX_URL=


# -----------------------------------------------------------------------------
# 5. 对象存储 OSS（仅 file.type=oss 时需要；默认 local 存储无需配置）
#    来源：application.yml:64-68
# -----------------------------------------------------------------------------
# 代码默认值：空
OSS_ACCESS_KEY_ID=
# 代码默认值：空
OSS_ACCESS_KEY_SECRET=
# 代码默认值：空
OSS_ENDPOINT=
# 代码默认值：空
OSS_BUCKET_NAME=
# 代码默认值：空
OSS_CUSTOM_DOMAIN=


# -----------------------------------------------------------------------------
# 6. Langfuse 可观测性（可选）
#    来源：application.yml:72-75
# -----------------------------------------------------------------------------
# 代码默认值：false（可选值 true / false）
LANGFUSE_ENABLED=
# 代码默认值：空
LANGFUSE_HOST=
# 代码默认值：空
LANGFUSE_PUBLIC_KEY=
# 代码默认值：空
LANGFUSE_SECRET_KEY=


# -----------------------------------------------------------------------------
# 7. Chroma 向量库（默认生效）
#    来源：application.yml
# -----------------------------------------------------------------------------
# 代码默认值：http://localhost（Docker Compose 内会自动改为 http://chroma）
CHROMA_HOST=
# 后端运行在 Docker 中时使用；代码默认值：http://chroma
CHROMA_DOCKER_HOST=
# Chroma 容器内部固定使用 8000；此值是宿主机端口，也是本地运行 Backend 时访问的端口。
# 若 Windows/Hyper-V 将 8000 列入排除端口范围，可改为 9000 等可用端口。
# 推荐值：9000（容器内部仍为 8000，可按宿主机可用端口调整）
CHROMA_PORT=9000
# 代码默认值：空（Chroma Cloud 使用 API key）
CHROMA_KEY_TOKEN=
# 代码默认值：空（仅启用 Basic Auth 时填写）
CHROMA_USERNAME=
CHROMA_PASSWORD=
# 代码默认值：SpringAiTenant
CHROMA_TENANT=
# 代码默认值：SpringAiDatabase
CHROMA_DATABASE=
# 代码默认值：data_agent
CHROMA_COLLECTION=
# 代码默认值：true（可选值 true / false）
CHROMA_INITIALIZE_SCHEMA=
# 代码默认值：0（关闭启动时维度校验；可设置为实际 Embedding 维度）
CHROMA_DIMENSION=


# -----------------------------------------------------------------------------
# 8. Chroma + Lucene 混合检索
# -----------------------------------------------------------------------------
# 代码默认值：true
HYBRID_SEARCH_ENABLED=
# 两路检索超时，代码默认值：3000（毫秒）
HYBRID_SEARCH_TIMEOUT_MS=
# RRF 前的向量/关键词候选数，代码默认值均为 30
HYBRID_VECTOR_CANDIDATE_TOP_K=
HYBRID_KEYWORD_CANDIDATE_TOP_K=
# RRF 平滑参数及权重，代码默认值：60 / 0.7 / 0.3
HYBRID_RRF_K=
HYBRID_DENSE_WEIGHT=
HYBRID_KEYWORD_WEIGHT=
# LLM 精排后保留数量，代码默认值：8
RERANK_TOP_N=
# Lucene 持久化目录；Docker Compose 会固定为 /app/vectorstore/lucene
KEYWORD_INDEX_PATH=
# 启动时从 Chroma 重建 Lucene，默认 true；大数据量场景可在首次重建后关闭
KEYWORD_INDEX_REBUILD_ON_START=


# -----------------------------------------------------------------------------
# 9. Docker Compose 示例数据源密码
# -----------------------------------------------------------------------------
# 必填后才能启动 docker-compose.yml 中的 MySQL/PostgreSQL 示例容器
MYSQL_ROOT_PASSWORD=
POSTGRES_USER=postgres
POSTGRES_PASSWORD=


# -----------------------------------------------------------------------------
# 10. Milvus 向量库（仅在 SPRING_PROFILES_ACTIVE=milvus 时生效）
#    来源：application-milvus.yml
# -----------------------------------------------------------------------------
# 代码默认值：localhost
MILVUS_HOST=
# 代码默认值：5423
MILVUS_PORT=
# 代码默认值：default
MILVUS_DATABASE=
# 代码默认值：vector_store
MILVUS_COLLECTION=
# 代码默认值：1024（必须与 Embedding 模型的输出维度一致）
MILVUS_DIMENSION=


# -----------------------------------------------------------------------------
# 11. 可选：HTTP 超时调优
#    来源：DataAgentConfiguration 中的 @Value 注解
#    Spring Boot 松绑定：属性 rest.connect.timeout 对应环境变量 REST_CONNECT_TIMEOUT
# -----------------------------------------------------------------------------
# 对应属性 rest.connect.timeout，代码默认值：600（单位：秒）
REST_CONNECT_TIMEOUT=
# 对应属性 rest.read.timeout，代码默认值：600（单位：秒）
REST_READ_TIMEOUT=
# 对应属性 webclient.response.timeout，代码默认值：600（单位：秒）
WEBCLIENT_RESPONSE_TIMEOUT=
